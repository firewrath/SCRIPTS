-- Teleport Logic
local function TweenTo(targetCFrame)
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    
    local hrp = character.HumanoidRootPart
    hrp.Anchored = true
    
    local distance = (hrp.Position - targetCFrame.Position).Magnitude
    local duration = distance / 150
    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
    
    local tween = TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})
    tween:Play()
    tween.Completed:Wait()
    
    hrp.Velocity = Vector3.zero
    hrp.RotVelocity = Vector3.zero
end

-- Base Locations
local BaseLocations = {
    Vector3.new(97.16, 24.01, 50.29),
    Vector3.new(-4.01, 23.94, 118.18),
    Vector3.new(-107.03, 24, 60.34),
    Vector3.new(-113.61, 24, -64.36),
    Vector3.new(-2.2, 24, -131.86),
    Vector3.new(100.31, 24, -70.23),
}

local function GetClosestBase(currentPosition)
    local closestPos = BaseLocations[1]
    local shortestDist = (currentPosition - closestPos).Magnitude
    
    for i = 2, #BaseLocations do
        local dist = (currentPosition - BaseLocations[i]).Magnitude
        if dist < shortestDist then
            shortestDist = dist
            closestPos = BaseLocations[i]
        end
    end
    return closestPos
end

-- Remote Utility
local function InvokePaperRemote(action, arg)
    local paper = ReplicatedStorage:FindFirstChild("Paper")
    if paper then
        local remote = paper:FindFirstChild("Remotes") and paper.Remotes:FindFirstChild("__remotefunction")
        if remote then
            if arg then
                return pcall(function() return remote:InvokeServer(action, arg) end)
            else
                return pcall(function() return remote:InvokeServer(action) end)
            end
        end
    end
    return false
end

