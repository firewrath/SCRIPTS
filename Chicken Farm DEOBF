-- Rebirth Settings (Note: This function was broken in the original source)
SubRebirth:CreateSection("--- Auto Rebirth Settings ---")

local function ParseSuffix(text)
    local number = tonumber(string.match(text, "[%d%.]+"))
    local suffix = string.match(text, "[A-Za-z]+")
    
    if not number then return 0 end
    if not suffix then return number end
    
    suffix = string.upper(suffix)
    if suffix == "K" then return number * 1000
    elseif suffix == "M" then return number * 1000000
    elseif suffix == "B" then return number * 1000000000
    elseif suffix == "T" then return number * 1000000000000
    end
    
    return number
end

local function HandleRebirth()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return end
    
    -- The original script had placeholder names and broken undefined variables here.
    -- This section is cleaned up to match the intended logic, but will fail unless you input the correct UI names.
    local success, uiElement = pcall(function()
        return playerGui:WaitForChild("SỬA_TÊN_UI_Ở_ĐÂY", 3)
            :WaitForChild("SỬA_TÊN_FRAME", 3)
            :WaitForChild("SỬA_TÊN_TEXTLABEL", 3)
    end)
    
    if success and uiElement then
        local currentStr, maxStr = string.match(uiElement.Text, "%$([%d%.%a]+)%s*/%s*([%d%.%a]+)")
        if currentStr and maxStr then
            local currentVal = ParseSuffix(currentStr)
            local maxVal = ParseSuffix(maxStr)
            
            if currentVal >= maxVal then
                print("[+] Đã đủ tiền! Đang gửi lệnh Rebirth lên server...")
                local invokeSuccess, result = InvokePaperRemote("Rebirth")
                
                if invokeSuccess then
                    print("[+] Lệnh Rebirth thành công!")
                    Window.Notify({ Title = "Rebirth", Content = "Thành công!", Type = "Success", Duration = 2 })
                    task.wait(1)
                else
                    warn("[-] Lỗi khi gọi Remote Rebirth: ", tostring(result))
                end
            end
        end
    else
        warn("Không thể tìm thấy UI TextLabel! Nhớ sửa tên UI bằng Dex Explorer trong script.")
    end
end

